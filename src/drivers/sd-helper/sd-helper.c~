#include "sd-driver.h"
#include "sd-helper.h"
#include "spi.h"
#include "samd21.h" 
#include <stdint.h>
#include <stddef.h>
#include <stdio.h>

// Global from sd-helper.c: 0 for SDSC, 1 for SDHC/SDXC
extern uint8_t g_is_sdhc; 

// Low-level helper prototypes assumed to be available:
// uint8_t sd_read_csd(spi_t* bus, uint8_t *csd_out); 
// uint8_t spi_master_init(spi_t* bus); 


/* === Helper to translate sd-helper return codes to driver.h return codes === */
static int sd_rc_to_driver_rc(uint8_t sd_rc) {
    switch (sd_rc) {
        // ... (implementation remains the same)
        case SD_OK:         return DRIVER_OK;
        case SD_ERR_SPI:
        case SD_ERR_TIMEOUT: return DRIVER_ERR_IO; 
        case SD_ERR_BAD_R1:
        case SD_ERR_RESP:
        case SD_ERR_TOKEN:
        case SD_ERR_PARAM:  return DRIVER_ERR_PARAM; 
        case SD_ERR_INIT:   return DRIVER_ERR_INIT;
        default:            return DRIVER_ERR_IO; 
    }
}

// -----------------------------------------------------------------------------
// Driver Function Implementations
// -----------------------------------------------------------------------------

static int sd_init_driver(struct driver *self) {
    // Note: self->ctx already points to &spi_s1 via g_sd_driver below.
    spi_t *bus = (spi_t *)self->ctx;
    uint8_t sd_rc;
    
    // 1. Initialize the SPI Bus
    // spi_master_init will use the .init_hz from the spi_t structure (400kHz).
    uint8_t spi_rc = spi_master_init(bus);
    if (spi_rc != SPI_OK) {
        return DRIVER_ERR_INIT; 
    }

    // 2. Low-level SD initialization 
    sd_rc = sd_init(bus);
    if (sd_rc != SD_OK) {
        return sd_rc_to_driver_rc(sd_rc);
    }

    // 3. Read CSD and Calculate Capacity (implementation remains the same)
    uint8_t csd_data[16];
    sd_rc = sd_read_csd(bus, csd_data);
    if (sd_rc != SD_OK) {
        return sd_rc_to_driver_rc(sd_rc);
    }

    uint8_t csd_structure = (csd_data[0] >> 6) & 0x03;

    if (csd_structure == 0) { // SDSC
        // SDSC calculation logic...
        uint32_t c_size = ((uint32_t)(csd_data[6] & 0x03) << 10) | ((uint32_t)csd_data[7] << 2) | ((uint32_t)(csd_data[8] >> 6));
        uint8_t read_bl_len = csd_data[5] & 0x0F; 
        uint32_t block_len = 1 << read_bl_len;
        uint8_t c_size_mult = (csd_data[9] >> 7) & 0x03;
        uint32_t mult = 1 << (c_size_mult + 2);

        self->total_sectors = (c_size + 1) * mult * (block_len / 512); 

    } else if (csd_structure == 1) { // SDHC/SDXC
        // SDHC/SDXC calculation logic...
        uint32_t c_size = ((uint32_t)(csd_data[7] & 0x3F) << 16) | ((uint32_t)csd_data[8] << 8) | ((uint32_t)csd_data[9]);

        self->total_sectors = (uint64_t)(c_size + 1) * 1024;
    } else {
        return DRIVER_ERR_UNSUPP;
    }
    
    self->sector_size = 512;
    self->total_size_bytes = self->total_sectors * 512;

    // 4. Set Max Speed
    // Use the .run_hz (8MHz) from your spi_s1 struct for the high-speed setting.
    sd_spi_set_hz(bus, bus->run_hz); 

    return DRIVER_OK;
}

// Read/Write/Sync/Deinit functions remain the same as the previous response.
static int sd_read_block_driver(struct driver *self, uint32_t lba, uint8_t *buffer) {
    spi_t *bus = (spi_t *)self->ctx;
    uint8_t sd_rc = sd_read_block(bus, lba, buffer);
    return sd_rc_to_driver_rc(sd_rc);
}
static int sd_write_block_driver(struct driver *self, uint32_t lba, const uint8_t *buffer) {
    spi_t *bus = (spi_t *)self->ctx;
    uint8_t sd_rc = sd_write_block(bus, lba, buffer);
    return sd_rc_to_driver_rc(sd_rc);
}
static int sd_write_blocks_driver(struct driver *self, uint32_t lba, const uint8_t *buffer, uint32_t count) {
    int rc = DRIVER_OK;
    const uint32_t sector_size = self->sector_size;
    for (uint32_t i = 0; i < count; i++) {
        rc = sd_write_block_driver(self, lba + i, (uint8_t *)(buffer + (i * sector_size)));
        if (rc != DRIVER_OK) return rc;
    }
    return DRIVER_OK;
}
static int sd_read_blocks_driver(struct driver *self, uint32_t lba, uint8_t *buffer, uint32_t count) {
    int rc = DRIVER_OK;
    const uint32_t sector_size = self->sector_size;
    for (uint32_t i = 0; i < count; i++) {
        rc = sd_read_block_driver(self, lba + i, buffer + (i * sector_size));
        if (rc != DRIVER_OK) return rc;
    }
    return DRIVER_OK;
}
static int sd_sync_driver(struct driver *self) { (void)self; return DRIVER_OK; }
static void sd_deinit_driver(struct driver *self) { (void)self; }


/* === The public driver_t instance === */

driver_t g_sd_driver = {
    .name               = "sd_spi",
    .sector_size        = 512, 
    .ctx                = &spi_s1, 
    .total_size_bytes   = 0,
    .total_sectors      = 0,

    // Function pointers implementation
    .init               = sd_init_driver,
    .read_block         = sd_read_block_driver,
    .write_block        = sd_write_block_driver,
    .write_blocks       = sd_write_blocks_driver, 
    .read_blocks        = sd_read_blocks_driver,
    .sync               = sd_sync_driver,
    .deinit             = sd_deinit_driver,
};
