import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

def plot_thesis_final(filename):
    df = pd.read_csv(filename)

    # Create the figure with dual y-axes
    fig, ax1 = plt.subplots(figsize=(10, 6))
    plt.style.use('seaborn-v0_8-whitegrid')

    # X-AXIS: Payload Size
    # We use linear scale here to clearly show the cliff step
    ax1.set_xlabel('Write Payload Size (Bytes)', fontsize=12, fontweight='bold')
    ax1.set_xticks(df['PayloadSize'])
    ax1.set_xticklabels(df['PayloadSize'], rotation=45)

    # Y-AXIS 1: Throughput (Blue)
    color_speed = '#1f77b4' # Blue
    ax1.set_ylabel('Throughput (KB/s)', color=color_speed, fontsize=12, fontweight='bold')
    ax1.plot(df['PayloadSize'], df['Throughput_KBps'], color=color_speed, marker='o', 
             linewidth=3, label='Throughput', zorder=10)
    ax1.tick_params(axis='y', labelcolor=color_speed)
    ax1.grid(True, axis='x', alpha=0.3)

    # Shade the "Safe Zone" (Green) vs "Danger Zone" (Red)
    # The cliff happens between index 3 (3042) and index 4 (4056)
    cliff_x = 3500 # approximate visual midpoint
    ax1.axvspan(0, cliff_x, color='green', alpha=0.1, label='Deterministic Zone')
    ax1.axvspan(cliff_x, max(df['PayloadSize']), color='red', alpha=0.1, label='Buffer Saturation Zone')

    # Y-AXIS 2: Latency (Red)
    ax2 = ax1.twinx()
    color_lat = '#d62728' # Red
    latency_ms = df['MaxLatency_us'] / 1000.0
    ax2.set_ylabel('Max Latency (ms)', color=color_lat, fontsize=12, fontweight='bold')
    ax2.plot(df['PayloadSize'], latency_ms, color=color_lat, marker='x', 
             linestyle='--', linewidth=2, label='Max Latency')
    ax2.tick_params(axis='y', labelcolor=color_lat)
    
    # Force Latency to start at 0 to show the scale of the jump
    ax2.set_ylim(bottom=0)

    # ANNOTATIONS
    # 1. The Peak
    peak_idx = 3 # 3042 bytes
    ax1.annotate(f'Sweet Spot\n{df["Throughput_KBps"][peak_idx]:.0f} KB/s', 
                 xy=(df['PayloadSize'][peak_idx], df['Throughput_KBps'][peak_idx]), 
                 xytext=(df['PayloadSize'][peak_idx], df['Throughput_KBps'][peak_idx]+20),
                 arrowprops=dict(facecolor='black', shrink=0.05),
                 horizontalalignment='center', fontweight='bold')

    # 2. The Cliff (Latency Spike)
    cliff_idx = 4 # 4056 bytes
    lat_val = latency_ms[cliff_idx]
    ax2.annotate(f'LATENCY SPIKE\n{lat_val:.0f} ms', 
                 xy=(df['PayloadSize'][cliff_idx], lat_val), 
                 xytext=(df['PayloadSize'][cliff_idx]+1000, lat_val),
                 arrowprops=dict(facecolor='red', shrink=0.05),
                 color='red', fontweight='bold')

    plt.title('ZINF Filesystem: The Limit of Determinism', fontsize=16, fontweight='bold', pad=20)
    fig.tight_layout()
    plt.savefig('zinf_limit_graph.png', dpi=300)
    print("Graph saved to zinf_limit_graph.png")

if __name__ == "__main__":
    plot_thesis_final("thesis_data.csv")
